OPENAI_API_KEY=sk-...
DECISIONS_MODEL=gpt-6-luna
PLANNER_MODEL=gpt-5.4-mini
PLANNER_INTERVAL_MS=5000

# Path to your 8-card deck knowledge file
DECK_FILE=deck.json

# Persistent opponent/matchup memory (battle reports + aggregated tips)
MEMORY_DIR=memory

# Playable arena rectangle (normalized 0..1): left,top,right,bottom
# Tune with: npm run calibrate  (red rectangle on debug/calibration.png)
ARENA_BOUNDS=0.08,0.12,0.92,0.78

# raw = faster (RGBA, no on-device PNG); png = classic screencap -p
SCREENCAP_FORMAT=raw

# Delay between battle loop ticks (ms)
BATTLE_LOOP_TOOL_CALL_MS=1500

# Optional: pin a specific device (adb devices)
ADB_SERIAL=

MIN_ACTION_CONFIDENCE=0.3
MIN_PLACEMENT_CONFIDENCE=0.3
REACTIVE_THREAT_THRESHOLD=5

# Resize screenshots before sending to APIs
SCREENSHOT_MAX_WIDTH=720

SWIPE_DURATION_MS=350

# tap = select then tap arena (recommended); swipe = drag gesture; drag = motionevent
LAUNCH_METHOD=tap
CARD_SELECT_DELAY_MS=220

# If true, decide and log but never send input events
DRY_RUN=false

# Save resized frames under debug/frames/
DEBUG_SAVE_FRAMES=false

# Append per-tick JSON lines under debug/ticks/
DEBUG_TICK_LOG=true

# On low placement confidence: use model's zone anyway (fallback) or cancel the play
LOW_CONFIDENCE_PLACEMENT=fallback
